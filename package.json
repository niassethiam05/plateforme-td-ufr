{
  "name": "plateforme-td-ufr",
  "private": true,
  "version": "0.1.0",
  "description": "Plateforme de numerisation et de gestion des fiches de TD de l'UFR",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "build": "npm run prisma:generate && npm run build:backend && npm run build:frontend",
    "start": "npm run start:prod --workspace backend"
  },
  "engines": {
    "node": ">=22.12"
  }
}

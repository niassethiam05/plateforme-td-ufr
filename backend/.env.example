# Serveur
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Base de donnees
DATABASE_URL="postgresql://td_ufr:td_ufr_password@localhost:5433/td_ufr_db?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stockage fichiers (S3 compatible - MinIO en developpement)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=td-ufr-fichiers
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Upload
MAX_FILE_SIZE_MB=20

# Emails (mot de passe oublie). Laisser SMTP_HOST vide en developpement :
# le lien de reinitialisation est alors affiche dans la console du backend.
# En production, renseigner le serveur SMTP du fournisseur d'email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Fiches de TD <no-reply@example.com>"

# --- Production uniquement (voir docs/deploiement.md) ---------------------
# Le backend sert aussi les pages du site (apres "npm run build").
# SERVE_FRONTEND=true
# Nombre de reverse proxys devant le backend (1 par defaut).
# TRUST_PROXY=1
# Premier compte administrateur, cree au demarrage s'il n'existe aucun admin.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
